{
  "name": "wintest",
  "version": "2.0.7",
  "description": "Chrome extension for previewing a page at multiple viewport sizes and zoom levels.",
  "main": "background.js",
  "scripts": {
    "browser": "node browser.js",
    "test": "node --test \"test/*.test.js\"",
    "build": "node build.js",
    "test:worker": "npm --prefix cloudflare run check",
    "check": "npm test && npm run build && npm run test:worker"
  },
