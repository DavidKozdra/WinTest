{
  "manifest_version": 3,
  "name": "WinTest",
  "version": "2.0.9",
  "description": "Preview pages locally and verify exact viewport screenshots with Cloudflare Browser Run.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://wintest-verifier.davidkozdra.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
